# =============================================================================
# Root Environment Configuration (Example)
# Copy to .env and fill in values. Never commit .env files.
# =============================================================================

# Environment: development | demo | uat | production
NODE_ENV=development
APP_ENV=development

# Database — MariaDB (team standard)
DB_ENABLED=false
MARIADB_HOST=localhost
MARIADB_PORT=3306
MARIADB_USER=myboss
MARIADB_PASSWORD=changeme
MARIADB_ROOT_PASSWORD=rootchangeme
DB_SYNCHRONIZE=true
DB_LOGGING=false

# Legacy aliases
POSTGRES_HOST=localhost
POSTGRES_PORT=3306
POSTGRES_USER=myboss
POSTGRES_PASSWORD=changeme
POSTGRES_DB=myboss_auth

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT (generate secure secrets for non-dev environments)
JWT_SECRET=change-this-to-a-secure-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Service Ports
AUTH_SERVICE_PORT=3001
USER_SERVICE_PORT=3002
CONFIG_SERVICE_PORT=3003
SQUAD_SERVICE_PORT=3004
SURVEY_SERVICE_PORT=3005

# Live chat (free Tawk.to — demo event)
CHAT_ENABLED=true
TAWK_PROPERTY_ID=demo
TAWK_WIDGET_ID=default
CHAT_EVENT_DAILY_USERS=1500
CHAT_EVENT_DURATION_DAYS=7
CHAT_APIGEE_BASE_PATH=/config/api/v1/chat

# Admin Portal
VITE_API_BASE_URL=http://localhost:3001

# Phrase (Localization)
PHRASE_PROJECT_ID=
PHRASE_ACCESS_TOKEN=

# Demo 2FA (temporary — replace with production 2FA provider)
TWO_FA_DEMO_ENABLED=true

# Orange OTP (backend-only — mobile never calls Orange APIs directly)
# OTP_PROVIDER=demo|orange
OTP_PROVIDER=demo
# ORANGE_OTP_ENABLED=true
ORANGE_SSO_TOKEN_URL=https://xpapis.orange.jo/sso/realms/v1/dev/sso/protocol/openid-connect/token
ORANGE_SSO_CLIENT_ID=
ORANGE_SSO_CLIENT_SECRET=
ORANGE_EMAIL_API_URL=http://preprod-notification.xyz.jt.jtgroup/email/send
ORANGE_EMAIL_CLIENT_NAME=sajelni
ORANGE_EMAIL_CHANNEL=survey_app
# blank (LTR) or blank_ar (RTL)
ORANGE_EMAIL_TYPE=blank
# Optional Apigee apiKey when provided for survey_app channel
ORANGE_EMAIL_API_KEY=
# ORANGE_SSO_API_KEY=   # defaults to ORANGE_EMAIL_API_KEY if unset

# Internal service-to-service sync (auth→user, squad→user)
INTERNAL_SERVICE_TOKEN=change-this-internal-sync-token

# Demo server (Docker deploy + mobile APK build)
DEMO_HOST=your.demo.server.ip
DEMO_ADMIN_EMAIL=admin@orange.com
DEMO_ADMIN_PASSWORD=admin123

# Optional extra CORS origins (comma-separated)
# CORS_ALLOWED_ORIGINS=https://admin-demo.orange.com

# Push notifications — Firebase (see docs/PUSH_FIREBASE_SETUP.md)
FCM_ENABLED=false
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_PATH=/run/secrets/fcm-service-account.json
# Host path to service account JSON (mounted into notification-service container)
FCM_SERVICE_ACCOUNT_HOST_PATH=./secrets/fcm-service-account.json
NOTIFICATION_SERVICE_URL=http://notification-service:3006/api/v1
PUSH_DISPATCH_ENABLED=true
NOTIFICATION_SERVICE_PORT=3006
