# =============================================================================
# Root Environment Configuration (Example)
# Copy to .env and fill in values. Never commit .env files.
# =============================================================================

# Environment: development | demo | uat | production
NODE_ENV=development
APP_ENV=development

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=myboss
POSTGRES_PASSWORD=changeme
POSTGRES_DB=myboss_dev

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT (generate secure secrets for non-dev environments)
JWT_SECRET=change-this-to-a-secure-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Service Ports
AUTH_SERVICE_PORT=3001
USER_SERVICE_PORT=3002
CONFIG_SERVICE_PORT=3003
SQUAD_SERVICE_PORT=3004
SURVEY_SERVICE_PORT=3005

# Live chat (free Tawk.to — demo event)
CHAT_ENABLED=true
TAWK_PROPERTY_ID=demo
TAWK_WIDGET_ID=default
CHAT_EVENT_DAILY_USERS=1500
CHAT_EVENT_DURATION_DAYS=7
CHAT_APIGEE_BASE_PATH=/config/api/v1/chat

# Admin Portal
VITE_API_BASE_URL=http://localhost:3001

# Phrase (Localization)
PHRASE_PROJECT_ID=
PHRASE_ACCESS_TOKEN=

# Demo 2FA (temporary — replace with production 2FA provider)
TWO_FA_DEMO_ENABLED=true

# Internal service-to-service sync (auth→user, squad→user)
INTERNAL_SERVICE_TOKEN=change-this-internal-sync-token

# Demo server (Docker deploy + mobile APK build)
DEMO_HOST=your.demo.server.ip
DEMO_ADMIN_EMAIL=admin@orange.com
DEMO_ADMIN_PASSWORD=change-me

# Optional extra CORS origins (comma-separated)
# CORS_ALLOWED_ORIGINS=https://admin-demo.orange.com
