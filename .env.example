# =============================================================================
# Root Environment Configuration (Example)
# Prefer a stage file, then copy to .env (never commit .env):
#   .env.development.example  — laptop / GitLab development
#   .env.production.example   — production (same DB + OTP as development)
#   .env.preprod.example      — staging (preprod OTP; dedicated DB when provided)
# GitLab copies: docs/devops/gitlab-*.env.example
# =============================================================================

# Environment: development | demo | preprod | uat | production
# See docs/deployment/STAGES.md
NODE_ENV=development
APP_ENV=development

# Database — development + production share this MySQL. Preprod uses a dedicated DB (see .env.preprod.example).
# Preferred: 10.1.165.105:3308. Connection string only (MYSQL_*). Schema lives in the corporate DB.
# TypeORM type: mysql. Keep DB_SYNCHRONIZE=false.
DB_ENABLED=true
MYSQL_HOST=10.1.165.105
MYSQL_PORT=3308
MYSQL_USER=my_boss_app
# If the password contains $, quote it so Compose keeps literals, e.g. MYSQL_PASSWORD='p@$$word'
MYSQL_PASSWORD=changeme
MYSQL_DATABASE=my_boss
DB_SYNCHRONIZE=false
DB_LOGGING=false
MYSQL_CONNECTION_LIMIT=1

# Redis (optional / future)
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT (generate secure secrets for non-dev environments)
JWT_SECRET=change-this-to-a-secure-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# API
PORT=3001
API_PORT=3001
API_INTERNAL_URL=http://127.0.0.1:3001/api/v1

# Live chat (free Tawk.to — demo event)
CHAT_ENABLED=true
TAWK_PROPERTY_ID=demo
TAWK_WIDGET_ID=default
CHAT_EVENT_DAILY_USERS=1500
CHAT_EVENT_DURATION_DAYS=7
CHAT_APIGEE_BASE_PATH=/api/v1/chat

# Admin Portal
VITE_API_BASE_URL=http://localhost:3001

# Phrase (Localization)
PHRASE_PROJECT_ID=
PHRASE_ACCESS_TOKEN=

# OTP — Orange SSO + Maxit.
# Development + production = PRODUCTION Maxit (10.4.3.27). See .env.development.example / .env.production.example
# Preprod (staging) = preprod SSO/email. See .env.preprod.example
TWO_FA_DEMO_ENABLED=false
OTP_PROVIDER=orange
ORANGE_OTP_ENABLED=true
ORANGE_OTP_FALLBACK_DEMO=false
ORANGE_OTP_ENV=production
ORANGE_SSO_TOKEN_URL=http://10.4.3.27:9001/sso/openid-connect/v1/token
ORANGE_SSO_CLIENT_ID=apigee-app
ORANGE_SSO_CLIENT_SECRET=
ORANGE_SSO_API_KEY=
ORANGE_EMAIL_API_URL=http://10.4.3.27:9001/maxit/notification/v1/email/send
ORANGE_EMAIL_CLIENT_NAME=sajelni
ORANGE_EMAIL_CHANNEL=survey_app
ORANGE_EMAIL_TYPE=blank
ORANGE_EMAIL_API_KEY=
# Preprod APIs (only when ORANGE_OTP_ENV=preprod):
# ORANGE_SSO_TOKEN_URL=http://10.1.112.95:9001/sso/openid-connect/v1/token
# ORANGE_EMAIL_API_URL=http://preprod-notification.xyz.jt.jtgroup/email/send

# Internal service-to-service sync (auth→user, squad→user)
INTERNAL_SERVICE_TOKEN=change-this-internal-sync-token

# Host used when baking admin URLs for Docker (rebuild admin after change)
# Local: 127.0.0.1  |  Preprod/prod: GitLab DEMO_HOST
DEMO_HOST=127.0.0.1
ADMIN_BUILD_MODE=demo
# VITE_APP_ENV=
# VITE_API_GATEWAY_ORIGIN=
DEMO_ADMIN_EMAIL=admin@orange.com
DEMO_ADMIN_EMAILS=
DEMO_ADMIN_PASSWORD=admin123

# Optional extra CORS origins (comma-separated). Production needs the admin origin, e.g.:
# CORS_ALLOWED_ORIGINS=http://<DEMO_HOST>:8081

# Push notifications — Firebase (see docs/PUSH_FIREBASE_SETUP.md)
FCM_ENABLED=false
FCM_PROJECT_ID=my-boss-app-38576
FCM_SERVICE_ACCOUNT_PATH=/run/secrets/fcm-service-account.json
# Place Firebase Admin SDK JSON at ./secrets/fcm-service-account.json (gitignored).
# Compose mounts ./secrets → /run/secrets. Set FCM_ENABLED=true after the file exists.
PUSH_DISPATCH_ENABLED=true
