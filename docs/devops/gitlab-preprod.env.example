# Preprod (staging) GitLab CI/CD variables
# Dedicated preprod MySQL (fill when DBA provides it). OTP = preprod SSO + Maxit.
# Do NOT commit a filled copy. Template: ../../.env.preprod.example
# Hosts (API host): 10.1.112.95 preprod-notification.xyz.jt.jtgroup

NODE_ENV=production
APP_ENV=preprod

DB_ENABLED=true
MYSQL_HOST=FILL_PREPROD_MYSQL_HOST
MYSQL_PORT=FILL_PREPROD_MYSQL_PORT
MYSQL_USER=FILL_PREPROD_MYSQL_USER
MYSQL_PASSWORD=FILL_PREPROD_MYSQL_PASSWORD
MYSQL_DATABASE=FILL_PREPROD_MYSQL_DATABASE
MYSQL_CONNECTION_LIMIT=1
DB_SYNCHRONIZE=false
DB_LOGGING=false

JWT_SECRET=FILL_OPENSSL_RAND_BASE64_48
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
INTERNAL_SERVICE_TOKEN=FILL_OPENSSL_RAND_BASE64_32

PORT=3001
API_PORT=3001
API_INTERNAL_URL=http://127.0.0.1:3001/api/v1

TWO_FA_DEMO_ENABLED=false
OTP_PROVIDER=orange
ORANGE_OTP_ENABLED=true
ORANGE_OTP_FALLBACK_DEMO=false
ORANGE_OTP_ENV=preprod
ORANGE_SSO_TOKEN_URL=http://10.1.112.95:9001/sso/openid-connect/v1/token
ORANGE_SSO_CLIENT_ID=apigee-app
ORANGE_SSO_CLIENT_SECRET=FILL_PREPROD_FROM_ORANGE
ORANGE_SSO_API_KEY=FILL_FROM_ORANGE
ORANGE_EMAIL_API_URL=http://preprod-notification.xyz.jt.jtgroup/email/send
ORANGE_EMAIL_CLIENT_NAME=sajelni
ORANGE_EMAIL_CHANNEL=survey_app
ORANGE_EMAIL_TYPE=blank
ORANGE_EMAIL_API_KEY=FILL_FROM_ORANGE

DEMO_ADMIN_EMAIL=areej.obaid@orange.com
DEMO_ADMIN_EMAILS=zaid.obeidat@orange.com
DEMO_ADMIN_PASSWORD=FILL_STRONG_PASSWORD
DEMO_HOST=FILL_PREPROD_PUBLIC_HOSTNAME_OR_IP
ADMIN_BUILD_MODE=production
VITE_APP_ENV=preprod
CORS_ALLOWED_ORIGINS=http://FILL_PREPROD_PUBLIC_HOSTNAME_OR_IP:8081

FCM_ENABLED=false
FCM_PROJECT_ID=my-boss-app-38576
FCM_SERVICE_ACCOUNT_PATH=/run/secrets/fcm-service-account.json
PUSH_DISPATCH_ENABLED=true
CHAT_ENABLED=true
