# Preprod GitLab CI/CD variables — myboss-backend ONLY
# Admin vars: myboss-admin/docs/gitlab/gitlab-preprod.env.example
# No localhost / 127.0.0.1. Do not bake into Docker images. Do not use myboss-platform for deploy.
# Hosts: 10.1.112.95 preprod-notification.xyz.jt.jtgroup
# After deploy, replace TODO_PREPROD_* with preprod public URLs.

NODE_ENV=production
APP_ENV=preprod

DB_ENABLED=true
MYSQL_HOST=10.1.169.88
MYSQL_PORT=3308
MYSQL_USER=my_boss_app_pre
MYSQL_PASSWORD=FILL_FROM_DBA
MYSQL_DATABASE=my_boss_pre
MYSQL_CONNECTION_LIMIT=1
DB_SYNCHRONIZE=false
DB_LOGGING=false

JWT_SECRET=FILL_OPENSSL_RAND_BASE64_48
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
INTERNAL_SERVICE_TOKEN=FILL_OPENSSL_RAND_BASE64_32

SWAGGER_ENABLED=false
# Do not set PORT (K8s APP_PORT=80). Do not set API_INTERNAL_URL.
# Optional: API_INTERNAL_URL=http://myboss-backend:80/api/v1

TWO_FA_DEMO_ENABLED=false
OTP_PROVIDER=orange
ORANGE_OTP_ENABLED=true
ORANGE_OTP_FALLBACK_DEMO=false
ORANGE_OTP_ENV=preprod
ORANGE_SSO_TOKEN_URL=http://10.1.112.95:9001/sso/openid-connect/v1/token
ORANGE_SSO_CLIENT_ID=apigee-app
ORANGE_SSO_CLIENT_SECRET=FILL_PREPROD_FROM_ORANGE
ORANGE_SSO_API_KEY=FILL_FROM_ORANGE
ORANGE_EMAIL_API_URL=http://preprod-notification.xyz.jt.jtgroup/email/send
ORANGE_EMAIL_CLIENT_NAME=sajelni
ORANGE_EMAIL_CHANNEL=survey_app
ORANGE_EMAIL_TYPE=blank
ORANGE_EMAIL_API_KEY=FILL_FROM_ORANGE

DEMO_ADMIN_EMAIL=areej.obaid@orange.com
DEMO_ADMIN_EMAILS=zaid.obeidat@orange.com
DEMO_ADMIN_PASSWORD=FILL_STRONG_PASSWORD

CORS_ALLOWED_ORIGINS=TODO_PREPROD_ADMIN_PUBLIC_URL

FCM_ENABLED=false
FCM_PROJECT_ID=my-customer-my-boss
FCM_SERVICE_ACCOUNT_PATH=/run/secrets/fcm-service-account.json
PUSH_DISPATCH_ENABLED=true
CHAT_ENABLED=true
