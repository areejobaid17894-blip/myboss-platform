# Production GitLab CI/CD variables
# Group myboss → Settings → CI/CD → Variables
# Template only — do NOT commit filled secrets.
# DB + OTP endpoints = same as development (MySQL 10.1.165.105:3308, Maxit 10.4.3.27).
#
# After K8s deploy, replace every TODO_* placeholder with the real public URLs / hostnames.

NODE_ENV=production
APP_ENV=production

# --- Database ---
DB_ENABLED=true
MYSQL_HOST=10.1.165.105
MYSQL_PORT=3308
MYSQL_USER=my_boss_app
MYSQL_PASSWORD=FILL_FROM_DBA
MYSQL_DATABASE=my_boss
MYSQL_CONNECTION_LIMIT=1
DB_SYNCHRONIZE=false
DB_LOGGING=false

# --- Auth ---
JWT_SECRET=FILL_OPENSSL_RAND_BASE64_48
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
INTERNAL_SERVICE_TOKEN=FILL_OPENSSL_RAND_BASE64_32

SWAGGER_ENABLED=false
# Do not set PORT (K8s APP_PORT=80). Do not set API_INTERNAL_URL.
# Optional: API_INTERNAL_URL=http://myboss-backend:80/api/v1

# --- Orange OTP (production Maxit) — OTP is sent to the login email address ---
TWO_FA_DEMO_ENABLED=false
OTP_PROVIDER=orange
ORANGE_OTP_ENABLED=true
ORANGE_OTP_FALLBACK_DEMO=false
ORANGE_OTP_ENV=production
ORANGE_SSO_TOKEN_URL=http://10.4.3.27:9001/sso/openid-connect/v1/token
ORANGE_SSO_CLIENT_ID=apigee-app
ORANGE_SSO_CLIENT_SECRET=FILL_FROM_ORANGE
ORANGE_SSO_API_KEY=FILL_FROM_ORANGE
ORANGE_EMAIL_API_URL=http://10.4.3.27:9001/maxit/notification/v1/email/send
ORANGE_EMAIL_CLIENT_NAME=sajelni
ORANGE_EMAIL_CHANNEL=survey_app
ORANGE_EMAIL_TYPE=blank
ORANGE_EMAIL_API_KEY=FILL_FROM_ORANGE

# --- Admin accounts ---
DEMO_ADMIN_EMAIL=areej.obaid@orange.com
DEMO_ADMIN_EMAILS=zaid.obeidat@orange.com
DEMO_ADMIN_PASSWORD=FILL_STRONG_PROD_PASSWORD

# --- Public admin URL (set after ingress — no localhost) ---
# Backend only. Admin VITE_* vars are on myboss-admin.
CORS_ALLOWED_ORIGINS=TODO_DEPLOY_ADMIN_PUBLIC_URL

# --- Push / chat ---
FCM_ENABLED=false
FCM_PROJECT_ID=my-customer-my-boss
FCM_SERVICE_ACCOUNT_PATH=/run/secrets/fcm-service-account.json
PUSH_DISPATCH_ENABLED=true
CHAT_ENABLED=true
